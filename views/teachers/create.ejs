<%- include('../partials/header', { title: 'Добавление преподавателя' }) %>

<h2>Добавление преподавателя</h2>
<% if (errors.length > 0) { %>
    <div class="errors">
        <p>Проверьте введённые данные:</p>
        <ul>
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form class="course-form" action="/teachers" method="POST" novalidate>
    <label for="name">Имя</label>
    <input id="name" name="name" value="<%= teacher.name || '' %>" required>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= teacher.email || '' %>" required>

    <label for="department">Кафедра</label>
    <input id="department" name="department" value="<%= teacher.department || '' %>" required>

    <label for="academicDegree">Учёная степень</label>
    <input id="academicDegree" name="academicDegree" value="<%= teacher.academicDegree || '' %>" placeholder="Например: Doctor, Master" required>

    <div class="actions">
        <button type="submit">Добавить преподавателя</button>
        <a href="/teachers">Отмена</a>
    </div>
</form>

<%- include('../partials/footer') %>
