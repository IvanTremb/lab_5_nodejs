<%- include('../partials/header', { title: 'Преподаватели' }) %>

<div class="page-heading">
    <h2>Преподаватели</h2>
    <% if (isAdmin) { %>
        <a class="button" href="/teachers/new">Добавить преподавателя</a>
    <% } %>
</div>

<% if (teachers.length === 0) { %>
    <p class="empty-state">Преподаватели не найдены</p>
<% } else { %>
    <p>Всего преподавателей: <%= teachers.length %></p>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Кафедра</th>
                    <th>Учёная степень</th>
                    <th>Курсов</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                <% teachers.forEach(teacher => { %>
                    <tr>
                        <td><%= teacher.name %></td>
                        <td><%= teacher.email %></td>
                        <td><%= teacher.department %></td>
                        <td><%= teacher.academicDegree %></td>
                        <td><%= teacher.Courses.length %></td>
                        <td>
                            <div class="actions">
                                <a class="button view" href="/teachers/<%= teacher.id %>">Просмотр</a>
                                <% if (isAdmin) { %>
                                    <a class="button edit" href="/teachers/<%= teacher.id %>/edit">Изменить</a>
                                    <form action="/teachers/<%= teacher.id %>/delete" method="POST" onsubmit="return confirm('Вы действительно хотите удалить этого преподавателя?')">
                                        <button class="delete" type="submit">Удалить</button>
                                    </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>
