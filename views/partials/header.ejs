<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> — Учебные курсы</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container">
            <h1>Система управления учебными курсами</h1>
            <div class="nav-row">
                <nav>
                    <a href="/courses">Курсы</a>
                    <a href="/teachers">Преподаватели</a>
                    <% if (isAdmin) { %>
                        <a href="/courses/new">Добавить курс</a>
                        <a href="/teachers/new">Добавить преподавателя</a>
                    <% } %>
                    <% if (currentUser) { %>
                        <a href="/statistics">Статистика</a>
                    <% } %>
                </nav>
                <div class="user-menu">
                    <% if (currentUser) { %>
                        <span class="user-name"><%= currentUser.name %><% if (isAdmin) { %> <span class="role-badge">admin</span><% } %></span>
                        <a href="/profile">Профиль</a>
                        <form action="/logout" method="POST">
                            <button class="link-button" type="submit">Выход</button>
                        </form>
                    <% } else { %>
                        <a href="/login">Вход</a>
                        <a href="/register">Регистрация</a>
                    <% } %>
                </div>
            </div>
        </div>
    </header>
    <main class="container">
