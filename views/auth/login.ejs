<%- include('../partials/header', { title: 'Вход' }) %>

<h2>Вход</h2>
<% if (message) { %>
    <div class="success"><%= message %></div>
<% } %>
<% if (errors.length > 0) { %>
    <div class="errors">
        <ul>
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form class="course-form auth-form" action="/login" method="POST" novalidate>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= email || '' %>" autocomplete="email">

    <label for="password">Пароль</label>
    <input id="password" name="password" type="password" autocomplete="current-password">

    <div class="actions">
        <button type="submit">Войти</button>
        <a href="/register">Ещё нет акаунта? Зарегистрируйтесь</a>
    </div>
</form>

<%- include('../partials/footer') %>
