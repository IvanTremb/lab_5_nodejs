<%- include('../partials/header', { title: course.title }) %>

<a href="/courses">← К списку курсов</a>
<article class="course-details">
    <h2><%= course.title %></h2>
    <dl>
        <dt>Количество кредитов</dt>
        <dd><%= course.credits %></dd>
        <dt>Семестр</dt>
        <dd><%= course.semester %></dd>
    </dl>
    <h3>Описание</h3>
    <p class="description"><%= course.description %></p>

    <h3>Преподаватель</h3>
    <% if (course.Teacher) { %>
        <dl>
            <dt>Имя</dt>
            <dd><a href="/teachers/<%= course.Teacher.id %>"><%= course.Teacher.name %></a></dd>
            <dt>Email</dt>
            <dd><%= course.Teacher.email %></dd>
            <dt>Кафедра</dt>
            <dd><%= course.Teacher.department %></dd>
        </dl>
    <% } else { %>
        <p>Преподаватель не указан</p>
    <% } %>

    <% if (isAdmin) { %>
        <div class="actions">
            <a class="button edit" href="/courses/<%= course.id %>/edit">Редактировать</a>
            <form action="/courses/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Вы действительно хотите удалить этот курс?')">
                <button class="delete" type="submit">Удалить</button>
            </form>
        </div>
    <% } %>
</article>

<%- include('../partials/footer') %>
